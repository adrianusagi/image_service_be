services:
  image-service-be:
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '1.5'
    env_file:
      - .env
    build: .
    container_name: "image-service-be"
    image: maven:3.9-eclipse-temurin-17
    volumes:
      # Dedicated volume for uploads to ensure persistence 
      # and clear separation from source code
      # - /home/prodserver/image-service/image_service_be/uploads:/app/uploads
      # Maven cache
      - maven-repo:/root/.m2
    working_dir: /app
    ports:
      - "5105:8080"
      - "5005:5005" # For debugging
    command: mvn spring-boot:run 
    tty: true  # This keeps the terminal open so you can see logs
    stdin_open: true
    restart: unless-stopped
    networks:
      ituaku_net:
        ipv4_address: 192.18.20.10

volumes:
  maven-repo:

networks:
  ituaku_net:
    external: true